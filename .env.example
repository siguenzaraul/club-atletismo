# Leave empty for local SQLite (file:./club-atletismo.db); set to a Postgres URL on Vercel.
# OJO: payload.config.ts hace `DATABASE_URI || DATABASE_URL`. La integración de Neon en Vercel
# define DATABASE_URL apuntando a PRODUCCIÓN en los tres entornos, así que nunca dejes que un
# `vercel env pull` lo escriba en tu `.env.local`: un `pnpm dev` se conectaría a producción.
DATABASE_URI=
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Provided automatically by the Vercel Blob integration; leave empty locally.
# Sin este token, `pnpm dev` regenera src/app/(payload)/admin/importMap.js y BORRA la entrada
# del shim de Blob. Si eso se commitea, el panel de admin se rompe en producción: revisa
# siempre `git diff` sobre ese fichero antes de commitear.
BLOB_READ_WRITE_TOKEN=

# ── Correo (Resend, vía Marketplace de Vercel) ───────────────────────────────
# Sin RESEND_API_KEY no se envía nada: Payload usa su adaptador mock (loguea a consola).
RESEND_API_KEY=
# Remitente. Debe estar en un dominio verificado en Resend (usa un subdominio, p. ej.
# mail.tudominio.es, para aislar la reputación de envío del dominio principal).
EMAIL_FROM_ADDRESS=
# 'true' fuerza el envío fuera de producción (previews, local). 'false' lo apaga en producción.
# Por defecto sólo se envía de verdad cuando VERCEL_ENV=production.
EMAIL_ENABLED=
# Caja de arena: si se define, TODO el correo va a esta dirección con el destinatario real en
# el asunto. Imprescindible hasta que el dominio esté verificado en Resend.
EMAIL_REDIRECT_TO=
# Destinatario del aviso de contacto si Ajustes del sitio → Email está vacío.
CONTACT_NOTIFY_TO=
